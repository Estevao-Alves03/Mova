# Copie para .env (não versionado). Valores abaixo são do Supabase local (`supabase status`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Só backend. Nunca no frontend nem no git.
SUPABASE_SERVICE_ROLE_KEY=

# Só para o seed e os testes.
SEED_PASSWORD=
SUPABASE_ANON_KEY=
